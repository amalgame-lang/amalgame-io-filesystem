namespace Tests

import Amalgame.IO.Filesystem
import Amalgame.Collections
import Amalgame.String

public class Program {
    static int Ok(name: string, cond: bool) {
        if (cond) {
            Console.WriteLine("[PASS] " + name)
            return 1
        }
        Console.WriteLine("[FAIL] " + name)
        return 0
    }

    static bool Has(xs: List<string>, v: string) {
        var i: int = 0
        while (i < xs.Count()) {
            let e: string = xs.Get(i)
            if (e == v) { return true }
            i = i + 1
        }
        return false
    }

    public static void Main(string[] args) {
        var nPass: int = 0
        var nTot: int = 0
        let root: string = "_fstest"

        // build a small tree: _fstest/{a.txt, b.md, sub/{c.md}}
        File.Mkdir(root)
        File.Mkdir(root + "/sub")
        File.WriteAll(root + "/a.txt", "hello")
        File.WriteAll(root + "/b.md", "# md")
        File.WriteAll(root + "/sub/c.md", "# nested")

        // List: 3 direct entries
        let entries: List<string> = Filesystem.List(root)
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("List count == 3", entries.Count() == 3)
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("List has a.txt", Program.Has(entries, "a.txt"))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("List has b.md", Program.Has(entries, "b.md"))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("List has sub", Program.Has(entries, "sub"))

        // IsDir / IsFile
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("sub is dir", Filesystem.IsDir(root + "/sub"))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("a.txt is not dir", !Filesystem.IsDir(root + "/a.txt"))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("a.txt is file", Filesystem.IsFile(root + "/a.txt"))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("sub is not file", !Filesystem.IsFile(root + "/sub"))
        let nopeList: List<string> = Filesystem.List(root + "/nope")
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("missing dir lists empty", nopeList.Count() == 0)

        // ListRecursive: 3 files, nested path joined, no bare "sub"
        let all: List<string> = Filesystem.ListRecursive(root)
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("recursive count == 3", all.Count() == 3)
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("recursive has a.txt", Program.Has(all, "a.txt"))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("recursive has sub/c.md", Program.Has(all, "sub/c.md"))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("recursive omits bare sub", !Program.Has(all, "sub"))

        // MakeDir: recursive (mkdir -p) creates missing parents
        let deep: string = root + "/x/y/z"
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("MakeDir deep returns true", Filesystem.MakeDir(deep))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("MakeDir created nested dir", Filesystem.IsDir(deep))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("MakeDir idempotent", Filesystem.MakeDir(deep))

        // Move: rename a file; old path gone, new path present
        File.WriteAll(root + "/src.txt", "move me")
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("Move returns true", Filesystem.Move(root + "/src.txt", root + "/dst.txt"))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("Move removed source", !Filesystem.IsFile(root + "/src.txt"))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("Move created target", Filesystem.IsFile(root + "/dst.txt"))

        // Remove: recursive delete of the whole tree, then idempotent
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("Remove tree returns true", Filesystem.Remove(root))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("Remove deleted root", !Filesystem.IsDir(root))
        nTot = nTot + 1 ; nPass = nPass + Program.Ok("Remove idempotent on missing", Filesystem.Remove(root))

        let nFail: int = nTot - nPass
        Console.WriteLine("")
        Console.WriteLine("Summary: " + String_FromInt(nPass) + " passed, " + String_FromInt(nFail) + " failed")
        if (nFail > 0) {
            Console.WriteLine("FAILED")
        }
    }
}
